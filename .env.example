// Environment variables configuration for School Budget & Action Plan System
# Copy this file to .env and adjust values for your environment

# Gemini AI API Key (Google AI Studio)
GEMINI_API_KEY=

# Cloud Run / Application Hosted URL
APP_URL=

# Database Connection (MySQL / MariaDB / Cloud SQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=school_budget_db
DB_USER=root
DB_PASS=

# Node.js Server Environment
NODE_ENV=development
