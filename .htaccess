DirectoryIndex prod_dist/index.html
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^api/(.*)$ api_bridge.php?route=$1 [QSA,L]
RewriteRule ^assets/(.*)$ prod_dist/assets/$1 [L]
RewriteRule ^$ prod_dist/index.html [L]
RewriteRule ^index\.html$ prod_dist/index.html [L]
RewriteRule ^(\.git|\.env|config/|src/|server\.ts) - [F,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . prod_dist/index.html [L]
</IfModule>
